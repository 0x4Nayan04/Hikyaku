# Explicit test resources. Provision these separately from the running application.
# Use a PostgreSQL role that can access only this test database.
TEST_DATABASE_URL=postgresql://hikyaku_test:hikyaku_test@localhost:5544/hikyaku_test
TEST_REDIS_URL=redis://localhost:6388/15
# Choose a fresh identifier per run. Share it with API/worker/browser tests in that run.
TEST_RUN_ID=local-change-me
NODE_ENV=test
ADMIN_BOOTSTRAP_SECRET=test-bootstrap-secret
SESSION_SECRET=test-session-secret-at-least-32-characters
