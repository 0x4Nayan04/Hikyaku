{$SITE_ADDRESS:localhost} {
  handle /v1/* {
    reverse_proxy api:3000
  }
  @noindex path_regexp ^/(login|bootstrap|dashboard|endpoints|events|deliveries|settings|admin|accept-invite|reset-password)(/|$)
  header @noindex X-Robots-Tag "noindex, nofollow"
  handle {
    header {
      X-Content-Type-Options nosniff
      X-Frame-Options DENY
      Referrer-Policy no-referrer
      Content-Security-Policy "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data:; font-src 'self'; connect-src 'self'; frame-ancestors 'none'; base-uri 'self'; form-action 'self'; object-src 'none'"
    }
    root * /srv
    handle /assets/* {
      @existingAsset file {path}
      header @existingAsset Cache-Control "public, max-age=31536000, immutable"
      file_server
    }
    handle {
      header Cache-Control "public, max-age=0, must-revalidate"
      try_files {path} /index.html
      file_server
    }
  }
  encode gzip
}
