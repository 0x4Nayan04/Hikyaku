{
  "name": "@webhook/shared",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "exports": {
    "./env": {
      "types": "./dist/env.d.ts",
      "default": "./dist/env.js"
    },
    "./constants": {
      "types": "./dist/constants.d.ts",
      "default": "./dist/constants.js"
    },
    "./enqueueDelivery": {
      "types": "./dist/enqueueDelivery.d.ts",
      "default": "./dist/enqueueDelivery.js"
    },
    "./eventStatus": {
      "types": "./dist/eventStatus.d.ts",
      "default": "./dist/eventStatus.js"
    },
    "./schema": {
      "types": "./dist/schema.d.ts",
      "default": "./dist/schema.js"
    },
    "./crypto": {
      "types": "./dist/crypto.d.ts",
      "default": "./dist/crypto.js"
    },
    "./zod": {
      "types": "./dist/zod.d.ts",
      "default": "./dist/zod.js"
    },
    "./password": {
      "types": "./dist/password.d.ts",
      "default": "./dist/password.js"
